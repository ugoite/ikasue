{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugoite.github.io/ikasue/contract/split-view.schema.json",
  "title": "ikasue SplitView contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["panes"],
  "properties": {
    "panes": {
      "type": "array",
      "items": { "$ref": "#/$defs/pane" }
    },
    "orientation": { "enum": ["horizontal", "vertical"] },
    "activePane": { "type": "string" },
    "sizes": { "type": "array", "items": { "$ref": "#/$defs/splitBasis" } },
    "collapsible": { "type": "boolean" },
    "collapsed": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "motionOrigin": { "enum": ["start", "end", "top", "bottom"] }
  },
  "$defs": {
    "pane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "content": { "type": "string" },
        "size": { "$ref": "#/$defs/splitBasis" },
        "minSize": { "$ref": "#/$defs/minSize" },
        "basis": {
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "$ref": "#/$defs/splitBasis" }
          ]
        },
        "grow": { "type": "number", "minimum": 0 },
        "shrink": { "type": "number", "minimum": 0 },
        "collapsible": { "type": "boolean" },
        "disabled": { "type": "boolean" }
      }
    },
    "splitBasis": {
      "type": "string",
      "pattern": "^(?:auto|0|(?:0|[0-9]+(?:\\.[0-9]+)?)(?:px|rem|em|ch|vw|vh|%|fr))$"
    },
    "minSize": {
      "type": "string",
      "pattern": "^(?:0|(?:0|[0-9]+(?:\\.[0-9]+)?)(?:px|rem|em|ch|vw|vh|%))$"
    }
  }
}
