{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugoite.github.io/ikasue/contract/split-view.schema.json",
  "title": "ikasue SplitView contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["panes"],
  "properties": {
    "panes": {
      "type": "array",
      "items": { "$ref": "#/$defs/pane" }
    }
  },
  "$defs": {
    "pane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "content": { "type": "string" },
        "basis": { "type": "number", "minimum": 0 }
      }
    }
  }
}
