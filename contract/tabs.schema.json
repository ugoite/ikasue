{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugoite.github.io/ikasue/contract/tabs.schema.json",
  "title": "ikasue Tabs contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "activeId": { "type": "string" }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "disabled": { "type": "boolean" }
      }
    }
  }
}
