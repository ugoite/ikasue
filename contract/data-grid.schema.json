{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugoite.github.io/ikasue/contract/data-grid.schema.json",
  "title": "ikasue DataGrid contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["columns"],
  "properties": {
    "columns": {
      "type": "array",
      "items": { "$ref": "#/$defs/column" }
    },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    },
    "selection": { "$ref": "#/$defs/selection" },
    "editing": { "$ref": "#/$defs/selection" },
    "selectionMode": { "enum": ["cell", "context"] },
    "editable": { "type": "boolean" },
    "density": { "enum": ["default", "compact"] }
  },
  "$defs": {
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "width": { "type": "number", "minimum": 0 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cells"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "cells": { "$ref": "#/$defs/cells" }
      }
    },
    "cells": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": ["string", "number", "boolean", "null"] },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["value"],
            "properties": {
              "value": { "type": "string" },
              "state": {
                "enum": ["clean", "created", "modified", "deleted", "error"]
              }
            }
          }
        ]
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "column"],
      "properties": {
        "row": { "type": "string", "minLength": 1 },
        "column": { "type": "string", "minLength": 1 }
      }
    }
  }
}
