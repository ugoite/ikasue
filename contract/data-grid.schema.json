{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugoite.github.io/ikasue/contract/data-grid.schema.json",
  "title": "ikasue DataGrid contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["columns"],
  "properties": {
    "columns": {
      "type": "array",
      "items": { "$ref": "#/$defs/column" }
    },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    },
    "selection": { "$ref": "#/$defs/selection" },
    "editable": { "type": "boolean" }
  },
  "$defs": {
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "width": { "type": "number", "minimum": 0 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cells"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "cells": { "type": "object", "additionalProperties": true }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "column"],
      "properties": {
        "row": { "type": "string", "minLength": 1 },
        "column": { "type": "string", "minLength": 1 }
      }
    }
  }
}
