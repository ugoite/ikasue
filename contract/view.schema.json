{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugoite.github.io/ikasue/contract/view.schema.json",
  "title": "ikasue serializable view",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind"],
  "properties": {
    "version": { "const": "ikasue-web/1" },
    "kind": {
      "enum": [
        "theme-root",
        "text",
        "editable-text",
        "text-field",
        "flex",
        "stack",
        "grid",
        "scroll-area",
        "separator",
        "tabs",
        "sidebar",
        "toolbar",
        "icon-button",
        "checkbox",
        "radio-group",
        "segmented-control",
        "field",
        "form",
        "data-grid",
        "history-timeline",
        "split-view",
        "side-panel",
        "bottom-panel",
        "loading-region",
        "dialog",
        "status-indicator",
        "alert",
        "progress"
      ]
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": { "$ref": "#/$defs/jsonRecord" },
        "variant": { "$ref": "#/$defs/jsonValue" },
        "content": { "$ref": "#/$defs/jsonValue" },
        "density": { "$ref": "#/$defs/jsonValue" },
        "tone": { "$ref": "#/$defs/jsonValue" },
        "selectable": { "$ref": "#/$defs/jsonValue" },
        "id": { "$ref": "#/$defs/jsonValue" },
        "value": { "$ref": "#/$defs/jsonValue" },
        "disabled": { "$ref": "#/$defs/jsonValue" },
        "label": { "$ref": "#/$defs/jsonValue" },
        "placeholder": { "$ref": "#/$defs/jsonValue" },
        "required": { "$ref": "#/$defs/jsonValue" },
        "description": { "$ref": "#/$defs/jsonValue" },
        "error": { "$ref": "#/$defs/jsonValue" },
        "direction": { "$ref": "#/$defs/jsonValue" },
        "wrap": { "$ref": "#/$defs/jsonValue" },
        "gap": { "$ref": "#/$defs/jsonValue" },
        "align": { "$ref": "#/$defs/jsonValue" },
        "justify": { "$ref": "#/$defs/jsonValue" },
        "children": { "$ref": "#/$defs/jsonValue" },
        "columns": { "$ref": "#/$defs/jsonValue" },
        "rows": { "$ref": "#/$defs/jsonValue" },
        "axis": { "$ref": "#/$defs/jsonValue" },
        "overscroll": { "$ref": "#/$defs/jsonValue" },
        "orientation": { "$ref": "#/$defs/jsonValue" },
        "role": { "$ref": "#/$defs/jsonValue" },
        "items": { "$ref": "#/$defs/jsonValue" },
        "activeId": { "$ref": "#/$defs/jsonValue" },
        "collapsed": { "$ref": "#/$defs/jsonValue" },
        "overflow": { "$ref": "#/$defs/jsonValue" },
        "icon": { "$ref": "#/$defs/jsonValue" },
        "type": { "$ref": "#/$defs/jsonValue" },
        "pressed": { "$ref": "#/$defs/jsonValue" },
        "checked": { "$ref": "#/$defs/jsonValue" },
        "options": { "$ref": "#/$defs/jsonValue" },
        "fields": { "$ref": "#/$defs/jsonValue" },
        "values": { "$ref": "#/$defs/jsonValue" },
        "status": { "$ref": "#/$defs/jsonValue" },
        "selection": { "$ref": "#/$defs/jsonValue" },
        "editable": { "$ref": "#/$defs/jsonValue" },
        "entries": { "$ref": "#/$defs/jsonValue" },
        "panes": { "$ref": "#/$defs/jsonValue" },
        "sizes": { "$ref": "#/$defs/jsonValue" },
        "collapsible": { "$ref": "#/$defs/jsonValue" },
        "motionOrigin": { "$ref": "#/$defs/jsonValue" },
        "title": { "$ref": "#/$defs/jsonValue" },
        "open": { "$ref": "#/$defs/jsonValue" },
        "side": { "$ref": "#/$defs/jsonValue" },
        "busy": { "$ref": "#/$defs/jsonValue" },
        "message": { "$ref": "#/$defs/jsonValue" },
        "severity": { "$ref": "#/$defs/jsonValue" },
        "dismissible": { "$ref": "#/$defs/jsonValue" },
        "loading": { "$ref": "#/$defs/jsonValue" },
        "max": { "$ref": "#/$defs/jsonValue" }
      }
    },
    "children": {
      "type": "array",
      "items": { "$ref": "#" }
    },
    "text": { "type": "string" }
  },
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "$ref": "#/$defs/jsonRecord" }
      ]
    },
    "jsonRecord": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    }
  }
}
