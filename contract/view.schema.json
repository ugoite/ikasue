{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugoite.github.io/ikasue/contract/view.schema.json",
  "title": "ikasue serializable view",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind"],
  "properties": {
    "version": { "const": "ikasue-web/1" },
    "kind": {
      "enum": [
        "theme-root",
        "text",
        "rule",
        "status-icon",
        "vertical",
        "horizontal",
        "icon-action",
        "action-strip",
        "boolean-text",
        "choice-group",
        "form-list",
        "data-grid",
        "data-table",
        "history-gutter",
        "history-timeline",
        "progress-region",
        "message-region",
        "bottom-dialog",
        "tabs",
        "split-view"
      ]
    },
    "props": {
      "type": "object",
      "additionalProperties": true
    },
    "children": {
      "type": "array",
      "items": { "$ref": "#" }
    },
    "text": { "type": "string" }
  }
}
