{
  "name": "@ugoite/ikasue",
  "version": "0.2.0",
  "description": "Planar adaptive UI components for information-dense workspaces.",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/ikasue.es.js"
    },
    "./style.css": "./dist/ikasue.css"
  },
  "scripts": {
    "setup": "npm install",
    "dev": "vite",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "test": "vitest run",
    "catalog": "vite --host 0.0.0.0",
    "docs": "npm run docs:dev",
    "docs:dev": "npm --prefix docs-site run dev",
    "docs:build": "npm --prefix docs-site run build",
    "docs:sync": "node scripts/check-docs-sync.mjs",
    "docs:check": "npm run docs:sync && npm --prefix docs-site run check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
