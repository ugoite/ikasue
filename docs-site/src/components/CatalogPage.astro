---
import "../../../src/styles.css";
import { sitePath } from "../data/site-path";

const locale = Astro.currentLocale === "en" ? "en" : "ja";
---

<div
  id="catalog"
  data-catalog-mount
  data-locale={locale}
  data-base-path={sitePath("")}
></div>

<script>
  import { mountCatalog } from "../../../src/index";

  document
    .querySelectorAll<HTMLElement>("[data-catalog-mount]")
    .forEach((target) => {
      const targetLocale = target.dataset.locale === "en" ? "en" : "ja";
      mountCatalog(target, {
        embedded: true,
        label:
          targetLocale === "en"
            ? "ikasue component catalog"
            : "ikasueコンポーネントカタログ",
        locale: targetLocale,
        basePath: target.dataset.basePath,
      });
    });
</script>
