---
import {
  COMPONENT_REGISTRY,
} from "../../../src/catalog/registry";
import { COMPONENT_UI_COPY } from "../data/component-copy";
import { sitePath } from "../data/site-path";

const locale = Astro.currentLocale === "en" ? "en" : "ja";
const ui = COMPONENT_UI_COPY[locale];
const localePrefix = locale === "en" ? "en/" : "";
---

<div class="component-matrix not-content">
  <p class="matrix-note">{ui.matrixNote}</p>
  <p class="matrix-contract">{ui.matrixContract}</p>
  <div class="table-scroll">
    <table aria-label={ui.matrixCaption}>
      <caption>{ui.matrixCaption}</caption>
      <thead>
        <tr>
          <th scope="col">{ui.component}</th>
          <th scope="col">{ui.category}</th>
          <th scope="col">{ui.summary}</th>
          <th scope="col">{ui.demo}</th>
        </tr>
      </thead>
      <tbody>
        {
          COMPONENT_REGISTRY.map((component) => (
            <tr>
              <th scope="row">
                <a href={sitePath(`${localePrefix}components/${component.id}/`)}>{component.displayName}</a>
                {locale === "ja" && <small>{component.displayNameJa}</small>}
              </th>
              <td>{component.documentation[locale].category}</td>
              <td>{component.summary[locale]}</td>
              <td>{ui.demoOnPage}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<style>
  .component-matrix {
    margin-block: 1.5rem;
  }

  .matrix-note {
    border-inline-start: 3px solid var(--sl-color-text-accent);
    padding-inline-start: 1rem;
  }

  .matrix-contract {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .table-scroll {
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 54rem;
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
  }

  th,
  td {
    border-block-end: 1px solid var(--sl-color-gray-5);
    padding: 0.75rem;
    text-align: start;
    vertical-align: top;
  }

  thead th {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-2);
  }

  tbody th {
    min-width: 10rem;
  }

  tbody th a {
    display: block;
  }

  small {
    display: block;
    color: var(--sl-color-gray-3);
    font-weight: 400;
  }
</style>
