        ["Retrospective", "", "focus"],
      ],
      legend: ["Confirmed", "Selected", "Field"],
    },
  },
  field: {
    ja: {
      kicker: "FIELD / MOBILE",
      title: "設備点検ジョブ",
      status: "同期済み · 10:42",
      axis: "縦: context → checklist → evidence",
      job: "JOB-381",
      route: "渋谷区 · 2 / 5 stops",
      connection: "4G · オフライン準備済み",
      location: "青葉ビル 4F / 空調室",
      address: "東京都渋谷区神南 1-2-3",
      arrive: "到着を記録",
      photo: "写真",
      call: "連絡",
      checklist: "チェックリスト",
      checks: ["電源ランプを確認", "フィルターを交換", "異音がないことを確認"],
      evidence: "証跡",
      reading: "測定値",
      value: "23.4 °C",
      upload: "写真 3枚 · 送信待ち",
      note: "備考を追加",
      finish: "作業を完了",
    },
    en: {
      kicker: "FIELD / MOBILE",
      title: "Equipment inspection job",
      status: "SYNCED · 10:42",
      axis: "vertical: context → checklist → evidence",
      job: "JOB-381",
      route: "Shibuya · stop 2 / 5",
      connection: "4G · offline-ready",
      location: "Aoba Building 4F / HVAC room",
      address: "1-2-3 Jinnan, Shibuya, Tokyo",
      arrive: "Record arrival",
      photo: "Photo",
      call: "Call",
      checklist: "Checklist",
      checks: [
        "Power indicator checked",
        "Filter replaced",
        "No abnormal noise",
      ],
      evidence: "Evidence",
      reading: "Reading",
      value: "23.4 °C",
      upload: "3 photos · waiting to send",
      note: "Add note",
      finish: "Complete job",
    },
  },
  observability: {
    ja: {
      kicker: "OBS / INCIDENT",
      title: "信頼性コンソール",
      status: "SEV-2 · 対応中",
      axis: "横: timeline / services / incident",
      timeline: "タイムライン",
      services: "サービス状態",
      incident: "INC-204 · 請求書同期",
      alert: "外部キーの不一致が再試行を止めています",
      timelineItems: [
        ["14:02", "デプロイ完了", "deploy"],
        ["14:07", "エラー率上昇", "alert"],
        ["14:11", "調査を開始", "focus"],
      ],
      serviceRows: [
        ["billing-api", "正常", "42 ms"],
        ["invoice-worker", "劣化", "1.8 s"],
        ["ledger-db", "正常", "18 ms"],
      ],
      metricLabels: ["再試行", "影響中", "経過"],
      metricValues: ["128", "3 customers", "09 min"],
      acknowledge: "引き受ける",
      retain: "前回のmetricsを保持中",
    },
    en: {
      kicker: "OBS / INCIDENT",
      title: "Reliability console",
      status: "SEV-2 · ACTIVE",
      axis: "horizontal: timeline / services / incident",
      timeline: "Timeline",
      services: "Service state",
      incident: "INC-204 · Invoice sync",
      alert: "An external key mismatch is stopping retries",
      timelineItems: [
        ["14:02", "Deploy complete", "deploy"],
        ["14:07", "Error rate rising", "alert"],
        ["14:11", "Investigation started", "focus"],
      ],
      serviceRows: [
        ["billing-api", "Healthy", "42 ms"],
        ["invoice-worker", "Degraded", "1.8 s"],
        ["ledger-db", "Healthy", "18 ms"],
      ],
      metricLabels: ["Retries", "Affected", "Elapsed"],
      metricValues: ["128", "3 customers", "09 min"],
      acknowledge: "Acknowledge",
      retain: "Retaining previous metrics",
    },
  },
} as const;

const COPY_BY_KIND = {
  operations: {
    ja: COPY.ja.operations,
    en: COPY.ja.en,
  },
  editor: COPY.editor,
  planning: COPY.planning,
  field: COPY.field,
  observability: COPY.observability,
} as const;
---

<section
  class={`example-surface example-surface--${kind}`}
  data-ikasue-surface={kind}
  aria-labelledby={`${surfaceId}-title`}
>
  {
    kind === "operations" &&
      (() => {
        const surface = COPY_BY_KIND.operations[locale];
        return (
          <>
            <header class="surface__header">
              <div>
                <span class="surface__kicker">{surface.kicker}</span>
                <h3 id={`${surfaceId}-title`}>{surface.title}</h3>
              </div>
              <span class="surface__status">
                <i aria-hidden="true" />
                {surface.status}
              </span>
              <span class="surface__axis">{surface.axis}</span>
            </header>
            <form
              class="surface__toolbar"
              data-ikasue-region="filters"
              aria-label={surface.title}
            >
              <label class="surface__field">
                <span>{surface.controls.scope}</span>
                <select aria-label={surface.controls.scope}>
                  <option>{surface.controls.production}</option>
                </select>
              </label>
              <label class="surface__field">
                <span>{surface.controls.status}</span>
                <select aria-label={surface.controls.status}>
                  <option>{surface.controls.active}</option>
                </select>
              </label>
              <label class="surface__field">
                <span>{surface.controls.owner}</span>
                <select aria-label={surface.controls.owner}>
                  <option>{surface.controls.allOwners}</option>
                </select>
              </label>
              <label class="surface__field surface__field--search">
                <span>{surface.controls.search}</span>
                <input
                  type="search"
                  placeholder={surface.controls.search}
                  aria-label={surface.controls.search}
                />
              </label>
              <button class="surface__button" type="button">
                {surface.controls.refresh}
              </button>
            </form>
            <div class="surface-operations__body" data-ikasue-axis="vertical">
              <section
                class="surface__region surface-operations__queue"
                data-ikasue-region="queue"
                aria-labelledby={`${surfaceId}-queue`}
              >
                <div class="surface__region-header">
                  <h4 id={`${surfaceId}-queue`}>{surface.queue}</h4>
                  <span class="surface__count">{surface.queueCount}</span>
                </div>
                <table class="surface__table">
                  <caption class="surface__visually-hidden">
                    {surface.queue}
                  </caption>
                  <thead>
                    <tr>
                      {surface.queueHeaders.map((header: string) => (
                        <th scope="col">{header}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {surface.rows.map((row: QueueRow, index: number) => (
                      <tr
                        class={index === 0 ? "is-selected" : undefined}
                        data-ikasue-selected={index === 0 ? "true" : "false"}
                      >
                        <td>
                          <button
                            class="surface__row-button"
                            type="button"
                            aria-label={`${surface.selection}: ${row.id} ${row.title}`}
                          >
                            <span class="surface__mono">{row.id}</span>
                            <strong>{row.title}</strong>
                            <small>{row.meta}</small>
                          </button>
                        </td>
                        <td class="surface__row-title">{row.title}</td>
                        <td>
                          <span class="surface__state">{row.state}</span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </section>
              <section
                class="surface__region surface-operations__summary"
                data-ikasue-region="summary"
                aria-labelledby={`${surfaceId}-summary`}
              >
                <div class="surface__region-header">
                  <h4 id={`${surfaceId}-summary`}>{surface.selection}</h4>
                </div>
                <div class="surface__stat">
                  <>
                    <span class="surface__mono">QUEUE POSITION</span>
                    <strong>01 / 18</strong>
                  </>
                </div>
                <div class="surface__stat">
                  <>
                    <span class="surface__mono">ATTENTION</span>
                    <strong>HIGH</strong>
                  </>
                </div>
                <p class="surface__message">{surface.message}</p>
              </section>
              <section
                class="surface__region surface-operations__detail"
                data-ikasue-region="detail"
                data-ikasue-owns="selection"
                aria-labelledby={`${surfaceId}-detail`}
              >
                <div class="surface__region-header">
                  <>
                    <div>
                      <>
                        <span class="surface__kicker">{surface.detail}</span>
                        <h4 id={`${surfaceId}-detail`}>
                          {surface.detailTitle}
                        </h4>
                      </>
                    </div>
                    <span class="surface__state">{surface.rows[0].state}</span>
                  </>
                </div>
                <dl class="surface__definition-list">
                  {surface.detailRows.map(([label, value]: DetailRow) => (
                    <div>
                      <dt>{label}</dt>
                      <dd>{value}</dd>
                    </div>
                  ))}
                </dl>
                <div class="surface__region-actions">
                  <button
                    class="surface__button surface__button--primary"
                    type="button"
                  >
                    {surface.assign}
                  </button>
                </div>
              </section>
            </div>
          </>
        );
      })()
  }

  {
    kind === "editor" &&
      (() => {
        const surface = COPY_BY_KIND.editor[locale];
        return (
          <>
            <header class="surface__header">
              <div>
                <>
                  <span class="surface__kicker">{surface.kicker}</span>
                  <h3 id={`${surfaceId}-title`}>{surface.title}</h3>
                </>
              </div>
              <span class="surface__status">
                <i aria-hidden="true" />
                {surface.status}
              </span>
              <span class="surface__axis">{surface.axis}</span>
            </header>
            <div class="surface-editor__body" data-ikasue-axis="horizontal">
              <form
                class="surface__region surface-editor__form"
                data-ikasue-region="editor"
                data-ikasue-owns="values status"
                aria-labelledby={`${surfaceId}-editor`}
              >
                <div class="surface__region-header">
                  <>
                    <h4 id={`${surfaceId}-editor`}>{surface.editor}</h4>
                    <span class="surface__state">{surface.draft}</span>
                  </>
                </div>
                <div class="surface-editor__fields">
                  <label class="surface__field">
                    <>
                      <span>{surface.fields.title}</span>
                      <input
                        type="text"
                        value={surface.titleValue}
                        aria-label={surface.fields.title}
                      />
                    </>
                  </label>
                  <label class="surface__field">
                    <>
                      <span>{surface.fields.slug}</span>
                      <input
                        class="surface__mono"
                        type="text"
                        value={surface.slugValue}
                        aria-label={surface.fields.slug}
                      />
                    </>
                  </label>
                  <label class="surface__field">
                    <>
                      <span>{surface.fields.body}</span>
                      <textarea rows="4" aria-label={surface.fields.body}>
                        {surface.bodyValue}
                      </textarea>
                    </>
                  </label>
                  <label class="surface__field">
                    <>
                      <span>{surface.fields.status}</span>
                      <select aria-label={surface.fields.status}>
                        <>
                          <option>{surface.draft}</option>
                          <option>{surface.saved}</option>
                        </>
                      </select>
                    </>
                  </label>
                </div>
                <div class="surface-editor__actions">
                  <>
                    <button
                      class="surface__button surface__button--primary"
                      type="button"
                    >
                      {surface.save}
                    </button>
                    <button class="surface__button" type="button">
                      {surface.open}
                    </button>
                    <span class="surface__mono">{surface.lastSaved}</span>
                  </>
                </div>
              </form>
              <article
                class="surface__region surface-editor__preview"
                data-ikasue-region="preview"
                aria-labelledby={`${surfaceId}-preview`}
              >
                <div class="surface__region-header">
                  <>
                    <h4 id={`${surfaceId}-preview`}>{surface.preview}</h4>
                    <span class="surface__state">{surface.saved}</span>
                  </>
                </div>
                <div class="surface-editor__document">
                  <span class="surface__kicker">IKASUE / NOTES</span>
                  <h4>{surface.previewTitle}</h4>
                  <p>{surface.previewIntro}</p>
                  <ul>
                    {surface.previewItems.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                  <p class="surface__message">{surface.lastSaved}</p>
                </div>
              </article>
            </div>
          </>
        );
      })()
  }

  {
    kind === "planning" &&
      (() => {
        const surface = COPY_BY_KIND.planning[locale];
        return (
          <>
            <header class="surface__header">
              <div>
                <>
                  <span class="surface__kicker">{surface.kicker}</span>
                  <h3 id={`${surfaceId}-title`}>{surface.title}</h3>
                </>
              </div>
              <span class="surface__status">
                <i aria-hidden="true" />
                {surface.status}
              </span>
              <span class="surface__axis">{surface.axis}</span>
            </header>
            <div
              class="surface__toolbar surface-planning__toolbar"
              data-ikasue-region="controls"
              aria-label={surface.title}
            >
              <span class="surface__field-label">{surface.mode}</span>
              <button
                class="surface__button surface__button--selected"
                type="button"
                aria-pressed="true"
              >
                {surface.week}
              </button>
              <button class="surface__button" type="button">
                {surface.resources}
              </button>
              <span class="surface__toolbar-spacer" />
              <button
                class="surface__button surface__button--primary"
                type="button"
              >
                {surface.add}
              </button>
            </div>
            <div class="surface-planning__body" data-ikasue-axis="horizontal">
              <div
                class="surface-planning__calendar"
                data-ikasue-region="calendar"
              >
                <table class="surface__table surface-calendar">
                  <caption class="surface__visually-hidden">
                    {surface.calendarLabel}
                  </caption>
                  <thead>
                    <tr>
                      <th scope="col" class="surface-calendar__time" />
                      {surface.days.map((day, index) => (
                        <th
                          scope="col"
                          class={index === 0 ? "is-selected" : undefined}
                        >
                          {day}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {surface.times.map((time, timeIndex) => (
                      <tr>
                        <th scope="row" class="surface-calendar__time">
                          {time}
                        </th>
                        {surface.days.map((_, dayIndex) => {
                          const event =
                            surface.events[timeIndex * 2 + (dayIndex % 2)];
                          return (
                            <td>
                              {event &&
                                (dayIndex === timeIndex % 4 ||
                                (timeIndex === 1 && dayIndex === 2) ? (
                                  <button
                                    class={`surface-event ${event[1] ? `surface-event--${event[1]}` : ""} ${event[2] ? `surface-event--${event[2]}` : ""}`}
                                    type="button"
                                    aria-label={`${time} ${event[0]}`}
                                  >
                                    {event[0]}
                                  </button>
                                ) : (
                                  <span
                                    class="surface-calendar__empty"
                                    aria-hidden="true"
                                  >
                                    —
                                  </span>
                                ))}
                            </td>
                          );
                        })}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div
                class="surface-planning__legend"
                data-ikasue-region="legend"
                aria-label={surface.mode}
              >
                {surface.legend.map((item, index) => (
                  <span>
                    <i
                      class={`surface-legend__mark surface-legend__mark--${index}`}
                      aria-hidden="true"
                    />
                    {item}
                  </span>
                ))}
              </div>
            </div>
          </>
        );
      })()
  }

  {
    kind === "field" &&
      (() => {
        const surface = COPY_BY_KIND.field[locale];
        return (
          <>
            <header class="surface__header">
              <div>
                <>
                  <span class="surface__kicker">{surface.kicker}</span>
                  <h3 id={`${surfaceId}-title`}>{surface.title}</h3>
                </>
              </div>
              <span class="surface__status">
                <i aria-hidden="true" />
                {surface.status}
              </span>
              <span class="surface__axis">{surface.axis}</span>
            </header>
            <div class="surface-field__body" data-ikasue-axis="vertical">
              <section
                class="surface-field__device"
                data-ikasue-region="job"
                aria-labelledby={`${surfaceId}-job`}
              >
                <div class="surface-field__mobile-bar">
                  <>
