---
type Locale = "ja" | "en";
type SurfaceKind =
  "operations" | "editor" | "planning" | "field" | "observability";

interface Props {
  kind: SurfaceKind;
  locale: Locale;
}

interface QueueRow {
  id: string;
  title: string;
  meta: string;
  state: string;
}

type DetailRow = readonly [string, string];

const { kind, locale } = Astro.props as Props;
const surfaceId = `example-surface-${kind}`;

const COPY = {
