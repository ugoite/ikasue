---
import "../../../src/styles.css";
import {
  exampleSurfaceCopy,
  type ExampleKind,
  type ExampleLocale,
} from "../../../src/catalog/examples";

interface Props {
  kind: ExampleKind;
  locale: ExampleLocale;
}

const { kind, locale } = Astro.props as Props;
const surface = exampleSurfaceCopy(locale, kind);
const surfaceId = `example-surface-${kind}`;
---

<section
  class={`ikasue-root example-surface example-surface--${kind}`}
  data-ikasue-example-surface
  data-example-kind={kind}
  data-locale={locale}
  aria-labelledby={`${surfaceId}-title`}
>
  <header class="surface__header">
    <div>
      <span class="surface__kicker">{surface.kicker}</span>
      <h3 id={`${surfaceId}-title`}>{surface.title}</h3>
    </div>
    <span class="surface__status">
      <i aria-hidden="true"></i>
      {surface.status}
    </span>
    <span class="surface__axis">{surface.axis}</span>
  </header>

  <div class="surface__mount" data-native-plane-mount></div>
</section>

<script>
  import { mountExampleSurfaces } from "../../../src/catalog/example-renderer";

  mountExampleSurfaces();
</script>

<style>
  .example-surface {
    --surface-pad: clamp(0.7rem, 2vw, 1rem);
    box-sizing: border-box;
    inline-size: 100%;
    margin-block: 1.75rem 2.25rem;
    border: 1px solid var(--line-strong);
    background: var(--canvas);
    color: var(--ink);
    font-family: var(--font-en), var(--font-ja), sans-serif;
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .example-surface :where(*, *::before, *::after) {
    box-sizing: border-box;
  }

  .example-surface :where(button, input, select, textarea) {
    border-radius: 0;
    box-shadow: none;
    font: inherit;
  }

  .surface__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem 1rem;
    align-items: start;
    padding: var(--surface-pad);
    border-block-end: 1px solid var(--line);
  }

  .surface__header h3 {
    margin: 0;
    color: var(--ink);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .surface__header h3 {
    font-size: 1.1rem;
  }

  .surface__kicker,
  .surface__axis,
  .surface__status {
    color: var(--faint);
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .surface__kicker {
    display: block;
    margin-block-end: 0.2rem;
  }

  .surface__status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .surface__status i {
    inline-size: 0.45rem;
    block-size: 0.45rem;
    background: var(--ink);
  }

  .surface__axis {
    grid-column: 1 / -1;
    padding-block-start: 0.45rem;
    border-block-start: 1px solid var(--line);
  }

  .surface__mount {
    display: grid;
    gap: 1.25rem;
    padding: var(--surface-pad);
  }

  @media (prefers-reduced-motion: reduce) {
    .example-surface *,
    .example-surface *::before,
    .example-surface *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
