---
import MobileMenuToggle from "@astrojs/starlight/components/MobileMenuToggle.astro";

const { hasSidebar } = Astro.locals.starlightRoute;
---

<script>
  import { defineIkaSue } from "../../../src/elements";

  defineIkaSue();
</script>

<ika-theme-root class="page sl-flex" data-ikasue-frame>
  <ika-toolbar class="header" data-ikasue-header role="banner">
    <slot name="header" />
  </ika-toolbar>
  {
    hasSidebar && (
      <ika-sidebar
        class="sidebar print:hidden"
        data-ikasue-sidebar
        aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
        role="navigation"
      >
        <MobileMenuToggle />
        <div
          id="starlight__sidebar"
          class="sidebar-pane"
          data-ikasue-sidebar-pane
        >
          <div class="sidebar-content sl-flex" data-ikasue-sidebar-content>
            <slot name="sidebar" />
          </div>
        </div>
      </ika-sidebar>
    )
  }
  <ika-scroll-area class="main-frame" data-ikasue-content-plane role="main">
    <slot />
  </ika-scroll-area>
</ika-theme-root>

<script is:inline>
  const frame = document.querySelector("[data-ikasue-frame]");

  frame
    ?.querySelectorAll(
      ".right-sidebar-container, mobile-starlight-toc, starlight-toc",
    )
    .forEach((element) => {
      element.setAttribute("data-ikasue-toc", "");
    });

  frame?.querySelectorAll("footer").forEach((element) => {
    element.setAttribute("data-ikasue-footer", "");
  });
</script>

<style>
  @layer starlight.core {
    .page {
      flex-direction: column;
      min-height: 100vh;
      color: var(--ikasue-ink);
      background: var(--ikasue-surface);
    }

    .header {
      display: flex;
      flex: 0 0 auto;
      align-items: center;
      z-index: var(--sl-z-index-navbar);
      position: sticky;
      inset-block-start: 0;
      width: 100%;
      height: var(--sl-nav-height);
      border-bottom: 1px solid var(--sl-color-hairline-shade);
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      padding-inline-end: var(--sl-nav-pad-x);
      background-color: var(--sl-color-bg-nav);
      color: var(--ikasue-ink);
    }

    :global([data-has-sidebar]) .header {
      padding-inline-end: calc(
        var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
      );
    }

    .sidebar-pane {
      visibility: var(--sl-sidebar-visibility, hidden);
      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset-block: var(--sl-nav-height) 0;
      inset-inline-start: 0;
      width: 100%;
      background-color: var(--sl-color-bg-sidebar);
      overflow-y: auto;
      scrollbar-gutter: stable;
    }

    :global([aria-expanded="true"]) ~ .sidebar-pane {
      --sl-sidebar-visibility: visible;
    }

    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 1rem var(--sl-sidebar-pad-x) 0;
      flex-direction: column;
      gap: 1rem;
    }

    @media (min-width: 50rem) {
      .sidebar-content::after {
        content: "";
        padding-bottom: 1px;
      }
    }

    .main-frame {
      display: block;
      min-width: 0;
      min-height: 0;
      padding: calc(1.5rem + var(--sl-mobile-toc-height))
        max(1rem, var(--sl-content-pad-x, 1.5rem)) 4rem;
      color: var(--ikasue-ink);
      background: var(--ikasue-surface);
    }

    @media (min-width: 50rem) {
      :global([data-has-sidebar]) .header {
        padding-inline-end: var(--sl-nav-pad-x);
      }

      .sidebar-pane {
        --sl-sidebar-visibility: visible;
        width: var(--sl-sidebar-width);
        background-color: var(--sl-color-bg-sidebar);
        border-inline-end: 1px solid var(--sl-color-hairline-shade);
      }

      .main-frame {
        margin-inline-start: var(--sl-sidebar-width);
      }
    }
  }
</style>
