---
import { Code, TabItem, Tabs } from "@astrojs/starlight/components";
import ExampleSurface from "./ExampleSurface.astro";
import {
  exampleCopy,
  type ExampleKind,
  type ExampleLocale,
} from "../data/example-content";

interface Props {
  kind: ExampleKind;
  locale: ExampleLocale;
}

const { kind, locale } = Astro.props as Props;
const copy = exampleCopy(locale, kind);
const javascriptLabel = "JavaScript implementation / usage";
const rustLabel = "Rust implementation sketch";
---

<div class="example-page">
  <p class="eyebrow">{copy.eyebrow}</p>
  <p class="lede">{copy.summary}</p>

  <h2>{copy.surfaceHeading}</h2>
  <ExampleSurface kind={kind} locale={locale} />

  <h2>{copy.implementationHeading}</h2>
  <p>{copy.implementationIntro}</p>
  <p class="component-list">
    {copy.componentsLabel}
    {
      copy.components.map((component, index) => (
        <>
          {index > 0 && " · "}
          <code>{component}</code>
        </>
      ))
    }
  </p>

  <Tabs>
    <TabItem label={javascriptLabel}>
      <Code code={copy.javascript} lang="js" title={javascriptLabel} />
    </TabItem>
    <TabItem label={rustLabel}>
      <Code code={copy.rust} lang="rust" title={rustLabel} />
    </TabItem>
  </Tabs>
</div>

<style>
  .example-page {
    --plane-border: color-mix(in srgb, var(--sl-color-white) 18%, transparent);
  }

  .eyebrow {
    color: var(--sl-color-text-accent);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    letter-spacing: 0.04em;
  }

  .lede {
    max-width: 52rem;
    font-size: var(--sl-text-lg);
  }

  .component-list {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .component-list code {
    color: var(--sl-color-white);
  }
</style>
