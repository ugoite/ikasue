---
import { Code, TabItem, Tabs } from "@astrojs/starlight/components";
import "../../../src/styles.css";
import {
  componentSource,
  findRegistryEntry,
} from "../../../src/catalog/registry";
import type { CatalogComponentId } from "../../../src/catalog/types";
import { COMPONENT_UI_COPY } from "../data/component-copy";
import { sitePath } from "../data/site-path";

interface Props {
  id: CatalogComponentId;
  simple?: boolean;
}

const { id, simple = false } = Astro.props;
const locale = Astro.currentLocale === "en" ? "en" : "ja";
const entry = findRegistryEntry(id);
const copy = entry.documentation[locale];
const ui = COMPONENT_UI_COPY[locale];
const source = componentSource(id);
const sourceRecipe = entry.source;
const localePrefix = locale === "en" ? "en/" : "";
const displayDefault = (property: (typeof entry.properties)[number]) =>
  locale === "en" ? property.defaultEn : property.defaultJa;
const contract = JSON.stringify(
  {
    component: entry.displayName,
    id: entry.id,
    props: Object.fromEntries(
      entry.properties.map((property) => [
        property.key,
        displayDefault(property),
      ]),
    ),
    plane: {
      axis: sourceRecipe.axis,
      options: sourceRecipe.planeOptions,
      children: sourceRecipe.children,
    },
    ownership: sourceRecipe.ownership,
    rustState: sourceRecipe.rustState,
    contract: [
      "new information enters from its semantic edge",
      "content is reallocated on one plane; no overlay is required",
      "keyboard and reduced-motion behavior remain available",
    ],
  },
  null,
  2,
);
const compact = simple && (id === "vertical" || id === "horizontal");
const compactId = id === "horizontal" ? "horizontal" : "vertical";
const compactCopy = {
  ja: {
    vertical: {
      eyebrow: "配置 / VERTICAL",
      summary:
        "3つの要素を、限られた高さの一枚のplaneへ上から順に置きます。axisはverticalです。fitをelasticにすると、focusした要素へ面積を渡し、収まらない要素はnavigationから選べます。",
      heading: "3要素を縦に置く",
      note: "axis: vertical / 利用可能範囲: 6 / fit: elastic / 矢印と領域選択でfocusを移動",
    },
    horizontal: {
      eyebrow: "配置 / HORIZONTAL",
      summary:
        "3つの要素を、限られた幅の一枚のplaneへ左から順に置きます。axisはhorizontalです。fitをelasticにすると、focusした要素へ面積を渡し、収まらない要素はnavigationから選べます。",
      heading: "3要素を横に置く",
      note: "axis: horizontal / 利用可能範囲: 6 / fit: elastic / 矢印と領域選択でfocusを移動",
    },
  },
  en: {
    vertical: {
      eyebrow: "LAYOUT / VERTICAL",
      summary:
        "Place three elements from top to bottom on one plane with bounded height. With a vertical axis and elastic fit, the focused element gets room; constrained siblings remain available through navigation.",
      heading: "Three items on one vertical plane",
      note: "axis: vertical / available: 6 / fit: elastic / move focus with arrows or region selection",
    },
    horizontal: {
      eyebrow: "LAYOUT / HORIZONTAL",
      summary:
        "Place three elements from left to right on one plane with bounded width. With a horizontal axis and elastic fit, the focused element gets room; constrained siblings remain available through navigation.",
      heading: "Three items on one horizontal plane",
      note: "axis: horizontal / available: 6 / fit: elastic / move focus with arrows or region selection",
    },
  },
} as const;
const compactText = compactCopy[locale][compactId];
---

<div class:list={["component-doc", { "component-doc--simple": compact }]}>
  {
    compact ? (
      <>
        <p class="eyebrow">{compactText.eyebrow}</p>
        <p class="lede">{compactText.summary}</p>
        <section
          class="component-interactive"
          aria-labelledby={`interactive-${entry.id}`}
        >
          <h2 id={`interactive-${entry.id}`}>{compactText.heading}</h2>
          <p class="interactive-note">{compactText.note}</p>
          <div
            data-component-demo
            data-component={entry.id}
            data-locale={locale}
            aria-label={`${entry.page[locale].title} ${compactText.heading}`}
          />
        </section>
        <h2>{locale === "en" ? "Minimal composition" : "最小composition"}</h2>
        <p class="source-note">
          {locale === "en"
            ? "The snippet below is the same registry source used by this demo."
            : "下のsnippetは、このdemoが使うregistryのsourceと同じです。"}
        </p>
        <Tabs>
          <TabItem label={ui.javascript}>
            <Code code={source.javascript} lang="js" title={ui.javascript} />
          </TabItem>
          <TabItem label={ui.rust}>
            <Code code={source.rust} lang="rust" title={ui.rust} />
          </TabItem>
        </Tabs>
      </>
    ) : (
      <>
        <p class="eyebrow">
          {locale === "ja"
            ? `${entry.displayNameJa} · ${copy.category}`
            : copy.category}
        </p>
        <p class="lede">{copy.summary}</p>

        <div class="doc-links">
          <span>
            {ui.demoId} <code>{entry.demo}</code>
          </span>
          <a href={sitePath(`${localePrefix}components/`)}>{ui.matrixLink}</a>
        </div>

        <section
          class="component-interactive"
          aria-labelledby={`interactive-${entry.id}`}
        >
          <h2 id={`interactive-${entry.id}`}>{ui.interactiveDemo}</h2>
          <p class="interactive-note">{ui.interactiveNote}</p>
          <div
            data-component-demo
            data-component={entry.id}
            data-locale={locale}
            aria-label={`${entry.page[locale].title} ${ui.interactiveDemo}`}
          />
        </section>

        <h2>{ui.contract}</h2>
        <p>{copy.philosophy}</p>
        <Code
          code={contract}
          lang="json"
          title={`${entry.page[locale].title} ${ui.contract}`}
        />

        <div class="guidance-grid">
          <section>
            <h2>{ui.useWhen}</h2>
            <p>{copy.useWhen}</p>
          </section>
          <section>
            <h2>{ui.avoidWhen}</h2>
            <p>{copy.avoidWhen}</p>
          </section>
        </div>

        <h2>{ui.implementation}</h2>
        <p>{copy.implementation}</p>
        <p class="source-note">{ui.implementationUsage}</p>
        <Tabs>
          <TabItem label={ui.javascript}>
            <Code code={source.javascript} lang="js" title={ui.javascript} />
          </TabItem>
          <TabItem label={ui.rust}>
            <Code code={source.rust} lang="rust" title={ui.rust} />
          </TabItem>
        </Tabs>

        <h2>{ui.properties}</h2>
        <div class="property-table">
          <table>
            <caption>{ui.propertiesCaption(entry.displayName)}</caption>
            <thead>
              <tr>
                <>
                  <th scope="col">{ui.key}</th>
                  <th scope="col">{ui.type}</th>
                  <th scope="col">{ui.defaultValue}</th>
                  <th scope="col">{ui.values}</th>
                </>
              </tr>
            </thead>
            <tbody>
              {entry.properties.length ? (
                entry.properties.map((property) => (
                  <tr>
                    <th scope="row">
                      <>
                        <code>{property.key}</code>
                        <small>
                          {locale === "ja"
                            ? property.labelJa
                            : property.labelEn}
                        </small>
                      </>
                    </th>
                    <td>
                      <code>{property.type}</code>
                    </td>
                    <td>
                      <code>{String(displayDefault(property))}</code>
                    </td>
                    <td>
                      {property.values.length
                        ? property.values.join(" · ")
                        : "—"}
                    </td>
                  </tr>
                ))
              ) : (
                <tr>
                  <td colspan="4">{ui.noProps}</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>

        <h2>{ui.behaviorAccessibility}</h2>
        <dl class="behavior-list">
          <div>
            <>
              <dt>{ui.goodFor}</dt>
              <dd>{copy.goodFor}</dd>
            </>
          </div>
          <div>
            <>
              <dt>{ui.avoidFor}</dt>
              <dd>{copy.avoidFor}</dd>
            </>
          </div>
          <div>
            <>
              <dt>{ui.interaction}</dt>
              <dd>{copy.interaction}</dd>
            </>
          </div>
          <div>
            <>
              <dt>{ui.keyboard}</dt>
              <dd>{copy.keyboard}</dd>
            </>
          </div>
          <div>
            <>
              <dt>{ui.accessibility}</dt>
              <dd>{copy.accessibility}</dd>
            </>
          </div>
        </dl>
      </>
    )
  }
</div>

<script>
  import { mountCatalog } from "../../../src/index";
  import type { CatalogComponentId } from "../../../src/catalog/types";

  document
    .querySelectorAll<HTMLElement>("[data-component-demo]")
    .forEach((target) => {
      const component = target.dataset.component as
        CatalogComponentId | undefined;
      if (!component) return;
      mountCatalog(target, {
        component,
        embedded: true,
        locale: target.dataset.locale === "en" ? "en" : "ja",
        showComponentPicker: false,
      });
    });
</script>

<style>
  .component-doc {
    --plane-border: color-mix(in srgb, var(--sl-color-white) 18%, transparent);
  }

  .component-doc--simple :global(.catalog-controls),
  .component-doc--simple :global(.embedded-demo-layout),
  .component-doc--simple :global(.embedded-demo-note) {
    display: none;
  }

  .component-doc--simple :global(.ikasue-root) {
    min-width: 0;
    max-width: 100%;
  }

  .eyebrow {
    color: var(--sl-color-text-accent);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    letter-spacing: 0.04em;
  }

  .lede {
    max-width: 52rem;
    font-size: var(--sl-text-lg);
  }

  .component-interactive {
    margin-block: 2rem 3rem;
    padding-block: 1.25rem 0;
    border-block: 1px solid var(--sl-color-gray-5);
  }

  .interactive-note {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .doc-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
    margin-block: 1rem 2rem;
    padding-block: 0.75rem;
    border-block: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-sm);
  }

  .guidance-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .guidance-grid section {
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-inline-start: 3px solid var(--sl-color-text-accent);
  }

  .source-note {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .guidance-grid h2 {
    margin-block-start: 0;
    font-size: var(--sl-text-h4);
  }

  .property-table {
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 38rem;
    border-collapse: collapse;
  }

  th,
  td {
    border-block-end: 1px solid var(--sl-color-gray-5);
    padding: 0.65rem;
    text-align: start;
    vertical-align: top;
  }

  thead th {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-2);
  }

  small {
    display: block;
    color: var(--sl-color-gray-3);
    font-weight: 400;
  }

  .behavior-list {
    margin-block: 1rem 0;
  }

  .behavior-list > div {
    display: grid;
    grid-template-columns: minmax(9rem, 0.4fr) 1fr;
    gap: 1rem;
    padding-block: 0.7rem;
    border-block-end: 1px solid var(--sl-color-gray-5);
  }

  dt {
    color: var(--sl-color-text-accent);
    font-weight: 650;
  }

  dd {
    margin: 0;
  }

  @media (max-width: 48rem) {
    .guidance-grid {
      grid-template-columns: 1fr;
    }

    .behavior-list > div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
