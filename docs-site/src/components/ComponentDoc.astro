---
import { findRegistryEntry } from "../../../src/catalog/registry";
import type {
  CatalogComponentId,
  CatalogLocale,
} from "../../../src/catalog/types";
import { IKA_ELEMENT_CONTRACTS } from "../../../src/abi";

interface Props {
  id: CatalogComponentId;
  locale?: CatalogLocale;
}
const { id, locale = "ja" } = Astro.props as Props;
const entry = findRegistryEntry(id);
const componentEntry = entry?.kind === "component" ? entry : undefined;
const abiEntry = IKA_ELEMENT_CONTRACTS[id];
const tag = `ika-${id}`;
const copy =
  locale === "ja"
    ? {
        contract: "Web ABI contract",
        contractText:
          "ikasueのcomponent pageは、公開Custom Elementを直接登録し、attribute、property、CustomEvent、methodの境界をそのまま説明します。",
        demo: "公開elementのlive demo",
        source: "elementの使い方",
        name: "名前",
        type: "型",
        defaultValue: "既定値",
        empty: "—",
      }
    : {
        contract: "Web ABI contract",
        contractText:
          "This component page registers the public Custom Element directly and documents the attribute, property, CustomEvent, and method boundaries.",
        demo: "Live public element demo",
        source: "Element usage",
        name: "Name",
        type: "Type",
        defaultValue: "Default",
        empty: "—",
      };
---

<article class="docs-component" data-kind={id}>
  <p class="eyebrow">{entry?.group ?? "component"}</p>
  <p>{entry?.summary[locale] ?? ""}</p>

  <section aria-labelledby={`${id}-demo`} data-ika-demo>
    <h2 id={`${id}-demo`}>{copy.demo}</h2>
    <p>
      <code>&lt;{tag}&gt;</code> is registered by importing ikasue and is used through
      its public Web ABI.
    </p>
    <div data-ika-demo-target data-ika-component={id} data-tag={tag}></div>
  </section>

  <section aria-labelledby={`${id}-contract`}>
    <h2 id={`${id}-contract`}>{copy.contract}</h2>
    <p>{copy.contractText}</p>
  </section>

  {
    componentEntry && abiEntry && (
      <>
        <section aria-labelledby={`${id}-properties`}>
          <h2 id={`${id}-properties`}>
            {locale === "ja" ? "Properties" : "Properties"}
          </h2>
          <table>
            <thead>
              <tr>
                <th scope="col">{copy.name}</th>
                <th scope="col">{copy.type}</th>
                <th scope="col">{copy.defaultValue}</th>
              </tr>
            </thead>
            <tbody>
              {abiEntry.properties.map((property) => (
                <tr>
                  <th scope="row">
                    <code>{property.name}</code>
                  </th>
                  <td>
                    <code>{property.type}</code>
                  </td>
                  <td>
                    {property.defaultValue === undefined
                      ? copy.empty
                      : String(property.defaultValue)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
        <p>
          Attributes:{" "}
          {abiEntry.attributes.length
            ? abiEntry.attributes.join(", ")
            : copy.empty}
        </p>
        <section aria-labelledby={`${id}-source`}>
          <h2 id={`${id}-source`}>{copy.source}</h2>
          <pre>
            <code>{componentEntry.source.typescript}</code>
          </pre>
          <pre>
            <code>{componentEntry.source.rust}</code>
          </pre>
        </section>
        <section aria-labelledby={`${id}-events-methods`}>
          <h2 id={`${id}-events-methods`}>Events and methods</h2>
          <p>
            Events:{" "}
            {abiEntry.events.length ? abiEntry.events.join(", ") : copy.empty}
          </p>
          <p>
            Methods:{" "}
            {abiEntry.methods.length ? abiEntry.methods.join(", ") : copy.empty}
          </p>
        </section>
      </>
    )
  }
</article>

<script>
  import { defineIkaSue } from "../../../src/elements";
  import type {
    IkaDataGridColumn,
    IkaDataGridRow,
  } from "../../../src/contract";

  defineIkaSue();
  document
    .querySelectorAll<HTMLElement>("[data-ika-demo-target]")
    .forEach((target) => {
      const id = target.dataset.ikaComponent ?? "text";
      const element = document.createElement(
        target.dataset.tag ?? `ika-${id}`,
      ) as HTMLElement & {
        columns?: readonly IkaDataGridColumn[];
        rows?: readonly IkaDataGridRow[];
        items?: readonly { id: string; label: string }[];
        activeId?: string;
        props?: Record<string, unknown>;
      };
      if (id === "data-grid") {
        element.columns = [
          { id: "id", label: "ID" },
          { id: "name", label: "Name" },
        ];
        element.rows = [{ id: "42", cells: { id: "42", name: "ika" } }];
        element.addEventListener("ika-selection-change", (event) => {
          target.dataset.lastEvent = JSON.stringify(
            (event as CustomEvent).detail,
          );
        });
      } else if (id === "tabs") {
        element.items = [
          { id: "overview", label: "Overview" },
          { id: "detail", label: "Detail" },
        ];
        element.activeId = "overview";
      } else {
        element.props = {};
      }
      target.append(element);
    });
</script>

<style>
  .docs-component section {
    margin-block: 1.5rem;
  }
  [data-ika-demo-target] {
    min-block-size: 7rem;
    display: block;
    padding: 1rem;
    border-block: 1px solid var(--sl-color-gray-5);
  }
  [data-ika-demo-target] > * {
    display: block;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th,
  td {
    padding: 0.6rem;
    border-block-end: 1px solid var(--sl-color-gray-5);
    text-align: start;
  }
  pre {
    overflow-x: auto;
  }
</style>
