---
import { IKA_ELEMENT_CONTRACTS } from "../../../src/abi";
import {
  componentDemo,
  componentSourceForProps,
} from "../../../src/catalog/demo";
import { findRegistryEntry } from "../../../src/catalog/registry";
import type {
  CatalogComponentId,
  CatalogLocale,
} from "../../../src/catalog/types";

interface Props {
  id: CatalogComponentId;
  locale?: CatalogLocale;
}

const { id, locale = "ja" } = Astro.props as Props;
const entry = findRegistryEntry(id);
const componentEntry = entry?.kind === "component" ? entry : undefined;
const abiEntry = IKA_ELEMENT_CONTRACTS[id];
const demo = componentDemo(id);
const tag = `ika-${id}`;
type Guidance = {
  use: string;
  avoid: string;
  keyboard: string;
  state: string;
  live: string;
};
const localized = (ja: string, en: string): string =>
  locale === "ja" ? ja : en;
const identityGuidance = (
  {
    "editable-text": {
      use: localized(
        "読んでからEnter/F2またはdouble clickで編集し、一本線のdraftとしてcommitします。",
        "Read first, then edit with Enter/F2 or double click and commit the single-line draft.",
      ),
      avoid: localized(
        "常時textareaにせず、読む状態と編集状態を同じ情報の連続として扱います。",
        "Do not turn the page into permanent textareas; keep reading and editing as one information flow.",
      ),
      keyboard: localized(
        "Enter/F2/double clickで編集、Escapeで取消、Enter/Tabでcommitします。",
        "Enter/F2/double click edits, Escape cancels, and Enter/Tab commits.",
      ),
      state: localized(
        "read → editing → modifiedの順で、破線から実線へ意味を変えます。",
        "read → editing → modified changes the underline from dashed to solid.",
      ),
      live: localized(
        "commit後も内容を残し、modified stateをその場で示します。",
        "Keep the value after commit and show modified state in place.",
      ),
    },
    tabs: {
      use: localized(
        "選択中のtabへ面積とpanelの方向を渡し、作業の現在地を明確にします。",
        "Give area and panel direction to the selected tab so the current work is clear.",
      ),
      avoid: localized(
        "色やunderlineだけでactiveを示さず、elastic variantを最初の選択肢にします。",
        "Do not rely on color or an underline alone; use the elastic variant first.",
      ),
      keyboard: localized(
        "Arrowはorientationに沿って移動し、Home/Endはtab群の端へ移動します。",
        "Arrow keys follow orientation; Home/End reach the edges of the tab set.",
      ),
      state: localized(
        "inactive → selected → disabledを面積、背景、操作可能性で分けます。",
        "inactive → selected → disabled differ through area, background, and operability.",
      ),
      live: localized(
        "panelは選択方向から入り、内容を消して待たせません。",
        "The panel enters from the selection direction without clearing content while waiting.",
      ),
    },
    "segmented-control": {
      use: localized(
        "密接した選択肢のうち、現在の選択へ面積を譲るelastic choiceです。",
        "An elastic choice where the current option owns more area among related choices.",
      ),
      avoid: localized(
        "小さな丸や同じ幅のbox列にせず、selected optionを仕事の起点にします。",
        "Avoid tiny circles or equal boxes; make the selected option the work origin.",
      ),
      keyboard: localized(
        "Arrow/Home/Endで視覚方向と同じ順序を移動します。",
        "Arrow/Home/End move in the same order as the visual direction.",
      ),
      state: localized(
        "selected optionだけがgrowし、disabledは順序を壊さず操作から外れます。",
        "Only the selected option grows; disabled options leave interaction without breaking order.",
      ),
      live: localized(
        "選択の面積変化を短いspring motionで伝えます。",
        "A short spring motion communicates the change in owned area.",
      ),
    },
    "data-grid": {
      use: localized(
        "cell、row peer、column peerを同時に見せ、差分をその場で編集します。",
        "Show the cell, row peer, and column peer together, and edit differences in place.",
      ),
      avoid: localized(
        "選択cellだけを強調して周辺文脈を消したり、編集時に表全体を置き換えたりしません。",
        "Do not erase surrounding context by highlighting only one cell or replacing the table while editing.",
      ),
      keyboard: localized(
        "Arrow/Home/Endはcellの視覚方向へ移動し、F2/Enterで編集、copy/pasteも同じcellを所有します。",
        "Arrow/Home/End follow the cell direction; F2/Enter edit, and copy/paste stay with that cell.",
      ),
      state: localized(
        "clean/created/modified/errorはcellのstateとして表面と下線に反映します。",
        "clean/created/modified/error appear as cell state through surface and underline.",
      ),
      live: localized(
        "編集内容を残したままcommitし、selectionとpeerを再計算します。",
        "Commit without losing the edit, then recalculate selection and peers.",
      ),
    },
    "split-view": {
      use: localized(
        "active paneへ面積を渡し、divider上のcontrolで閉じる/戻すworkspaceです。",
        "A workspace that gives area to the active pane and collapses or restores it from the divider.",
      ),
      avoid: localized(
        "pane上にfloating controlを置くResizableSplitPaneにはしません。",
        "Do not turn it into a ResizableSplitPane with floating controls over the pane.",
      ),
      keyboard: localized(
        "paneをfocusしてEnter/Space、dividerはorientationの方向で操作します。",
        "Focus a pane and use Enter/Space; operate the divider along its orientation.",
      ),
      state: localized(
        "active/collapsedは面積とdividerのgeometryとして表します。",
        "active/collapsed are expressed through area and divider geometry.",
      ),
      live: localized(
        "active paneのtrack比率をspringで再配分します。",
        "Reallocate track ratios toward the active pane with a spring motion.",
      ),
    },
    "side-panel": {
      use: localized(
        "mainとpanelを同じtrackに置き、開くとmainを押して情報を追加します。",
        "Place main and panel in sibling tracks; opening pushes main to add information.",
      ),
      avoid: localized(
        "mainの上へoverlayせず、side=start/endとmotion originを一致させます。",
        "Do not overlay main; match side=start/end with the motion origin.",
      ),
      keyboard: localized(
        "mainからpanelへTab順を保ち、Escapeなどhostのclose操作へ戻します。",
        "Keep Tab order from main to panel and return to the host close action such as Escape.",
      ),
      state: localized(
        "closed/openは0frからpanel trackへの変化として表します。",
        "closed/open changes the panel track from 0fr to its working size.",
      ),
      live: localized(
        "panelは指定edgeから入り、mainは同時に狭くなります。",
        "The panel enters from the chosen edge while main narrows at the same time.",
      ),
    },
    "bottom-panel": {
      use: localized(
        "mainの下にrowを増やし、outputや補助情報を上の仕事と同時に残します。",
        "Add a row below main so output and supporting information remain with the work above.",
      ),
      avoid: localized(
        "画面中央のmodalやoverlayで上の情報を隠しません。",
        "Do not hide the information above with a centered modal or overlay.",
      ),
      keyboard: localized(
        "mainからbottom rowへ自然なTab順で到達できるようにします。",
        "Keep a natural Tab order from main to the bottom row.",
      ),
      state: localized(
        "closed/openは0frからcontent rowへの変化として表します。",
        "closed/open changes the panel row from 0fr to its content size.",
      ),
      live: localized(
        "panelは下端から入り、mainの内容を消さずに押し上げます。",
        "The panel enters from the bottom and pushes up without clearing main content.",
      ),
    },
    "loading-region": {
      use: localized(
        "同じcontentを残したまま、対象regionだけをneutral waveでbusyにします。",
        "Keep the same content and mark only the target region busy with a neutral wave.",
      ),
      avoid: localized(
        "中央spinnerや空のplaceholderへ置き換えません。",
        "Do not replace the work with a centered spinner or empty placeholder.",
      ),
      keyboard: localized(
        "busy中も読み取り可能なcontentとfocus順を維持します。",
        "Keep readable content and focus order while busy.",
      ),
      state: localized(
        "idle/busyはaria-busyとwaveだけを変え、情報のstateを消しません。",
        "idle/busy changes aria-busy and the wave only; it does not erase information state.",
      ),
      live: localized(
        "waveはpointer-events:noneで、読みながら処理の対象を確認できます。",
        "The wave uses pointer-events:none so the work target stays readable.",
      ),
    },
  } as Partial<Record<CatalogComponentId, Guidance>>
)[id];
const guidance = identityGuidance ?? {
  use:
    locale === "ja"
      ? "読む状態を主役にし、選択・編集・更新が必要な面だけへ場所と注意を渡します。"
      : "Keep the readable state primary, then give area and attention to the surface that needs work.",
  avoid:
    locale === "ja"
      ? "常設の入力box、意味のないcard、overlay、通常選択への意味色を増やしません。"
      : "Avoid permanent input chrome, ornamental cards, overlays, and semantic color for ordinary selection.",
  keyboard:
    locale === "ja"
      ? "Tabは順序、Arrowは視覚方向、Home/Endは範囲の端へ一致させます。"
      : "Tab follows order, arrows follow visual direction, and Home/End reach the edges.",
  state:
    locale === "ja"
      ? "cleanを基準に、created/modified/deleted/errorだけが下線・淡い面・意味色を持ちます。"
      : "Clean is the baseline; created, modified, deleted, and error own the state surface.",
  live:
    locale === "ja"
      ? "内容を消さず、選択の面積・出現方向・対象regionのmotionで仕事の変化を示します。"
      : "Keep content present and express change through selection area and directional motion.",
};
const copy =
  locale === "ja"
    ? {
        contract: "Web ABI contract",
        contractText:
          "公開Custom Elementを直接使い、attribute、property、CustomEvent、methodの境界をそのまま確認できます。",
        demo: "ライブサンプル",
        options: "オプション",
        preview: "描画",
        code: "コード",
        typescript: "TypeScript",
        rust: "Rust / WASM",
        ready: "オプションを変えると描画とコードが更新されます。",
        source: "現在の設定から生成したコード",
        attributes: "Attributes",
        eventsMethods: "Events and methods",
        design: "設計思想",
        use: "使う",
        avoid: "避ける",
        keyboard: "Keyboard",
        state: "State",
        live: "Live behavior",
        name: "名前",
        type: "型",
        defaultValue: "既定値",
        empty: "—",
      }
    : {
        contract: "Web ABI contract",
        contractText:
          "Use the public Custom Element directly and inspect the attribute, property, CustomEvent, and method boundaries in one place.",
        demo: "Live example",
        options: "Options",
        preview: "Preview",
        code: "Code",
        typescript: "TypeScript",
        rust: "Rust / WASM",
        ready: "Change an option to update both the preview and the code.",
        source: "Code generated from the current options",
        attributes: "Attributes",
        eventsMethods: "Events and methods",
        design: "Design rationale",
        use: "Use",
        avoid: "Avoid",
        keyboard: "Keyboard",
        state: "State",
        live: "Live behavior",
        name: "Name",
        type: "Type",
        defaultValue: "Default",
        empty: "—",
      };
---

<article class="docs-component" data-kind={id}>
  <header class="docs-component-heading">
    <p class="eyebrow">{entry?.group ?? "component"}</p>
    <p>{entry?.summary[locale] ?? ""}</p>
  </header>

  <section class="identity-guidance" aria-labelledby={`${id}-identity`}>
    <h2 id={`${id}-identity`}>{copy.design}</h2>
    <p>{entry?.summary[locale] ?? ""}</p>
    <div class="identity-guidance-grid">
      <div>
        <h3>{copy.use}</h3>
        <p>
          {guidance.use}
        </p>
      </div>
      <div>
        <h3>{copy.avoid}</h3>
        <p>
          {guidance.avoid}
        </p>
      </div>
      <div>
        <h3>{copy.keyboard}</h3>
        <p>
          {guidance.keyboard}
        </p>
      </div>
      <div>
        <h3>{copy.state}</h3>
        <p>
          {guidance.state}
        </p>
      </div>
      <div>
        <h3>{copy.live}</h3>
        <p>
          {guidance.live}
        </p>
      </div>
    </div>
  </section>

  {
    id === "editable-text" && (
      <section class="editable-state-sequence" aria-label="EditableText states">
        <span data-state="read">read / dashed underline</span>
        <span data-state="editing">editing / solid underline</span>
        <span data-state="modified">modified / changed value</span>
        <span data-state="error">error / semantic attention</span>
      </section>
    )
  }

  <section class="demo-section" aria-labelledby={`${id}-demo`}>
    <div class="section-heading">
      <div>
        <h2 id={`${id}-demo`}>{copy.demo}</h2>
        <p>
          <code>&lt;{tag}&gt;</code> is the canonical runtime element. Use the controls,
          then switch between the rendered result and its provider code.
        </p>
      </div>
      <span class="demo-contract">{tag}</span>
    </div>

    <div
      class="demo-workbench"
      data-ika-demo-root
      data-ika-component={id}
      data-ika-locale={locale}
    >
      <div class="demo-options">
        <div class="demo-options-heading">
          <h3>{copy.options}</h3>
          <span>live</span>
        </div>
        <div class="demo-control-list" data-ika-control-list></div>
      </div>

      <div class="demo-output">
        <div
          class="demo-view-tabs"
          id={`${id}-demo-mode-tabs`}
          data-ika-tab-group="mode"
          role="tablist"
          aria-label={`${copy.demo} view`}
        >
          <button
            type="button"
            role="tab"
            id={`${id}-demo-preview-tab`}
            aria-controls={`${id}-demo-preview-panel`}
            aria-selected="true"
            tabindex="0"
            data-ika-mode="preview"
          >
            {copy.preview}
          </button>
          <button
            type="button"
            role="tab"
            id={`${id}-demo-code-tab`}
            aria-controls={`${id}-demo-code-panel`}
            aria-selected="false"
            tabindex="-1"
            data-ika-mode="code"
          >
            {copy.code}
          </button>
        </div>

        <div
          id={`${id}-demo-preview-panel`}
          role="tabpanel"
          aria-labelledby={`${id}-demo-preview-tab`}
          data-ika-mode-panel="preview"
        >
          <div class="demo-preview" data-ika-preview>
            <p class="demo-fallback">{copy.ready}</p>
          </div>
        </div>

        <div
          id={`${id}-demo-code-panel`}
          role="tabpanel"
          aria-labelledby={`${id}-demo-code-tab`}
          data-ika-mode-panel="code"
          hidden
        >
          <div
            class="demo-provider-tabs"
            id={`${id}-demo-provider-tabs`}
            data-ika-tab-group="provider"
            role="tablist"
            aria-label="Code provider"
          >
            <button
              type="button"
              role="tab"
              id={`${id}-demo-typescript-tab`}
              aria-controls={`${id}-demo-provider-panel`}
              aria-selected="true"
              tabindex="0"
              data-ika-provider="typescript"
            >
              {copy.typescript}
            </button>
            <button
              type="button"
              role="tab"
              id={`${id}-demo-rust-tab`}
              aria-controls={`${id}-demo-provider-panel`}
              aria-selected="false"
              tabindex="-1"
              data-ika-provider="rust"
            >
              {copy.rust}
            </button>
          </div>
          <div
            id={`${id}-demo-provider-panel`}
            role="tabpanel"
            aria-labelledby={`${id}-demo-typescript-tab`}
            data-ika-provider-panel
          >
            <p class="demo-code-caption">{copy.source}</p>
            <pre
              class="demo-code"
              data-language="typescript"><code data-ika-code>{componentSourceForProps(id, demo.props, "typescript")}</code></pre>
          </div>
        </div>

        <p class="demo-status" role="status" data-ika-demo-status>
          {copy.ready}
        </p>
      </div>
      <script
        is:inline
        type="application/json"
        data-ika-demo-config
        set:html={JSON.stringify({
          props: demo.props,
          controls: demo.controls,
        })}
      />
    </div>
  </section>

  <section aria-labelledby={`${id}-contract`} class="contract-section">
    <h2 id={`${id}-contract`}>{copy.contract}</h2>
    <p>{copy.contractText}</p>
  </section>

  {
    componentEntry && abiEntry && (
      <>
        <section aria-labelledby={`${id}-properties`}>
          <h2 id={`${id}-properties`}>
            {locale === "ja" ? "Properties" : "Properties"}
          </h2>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th scope="col">{copy.name}</th>
                  <th scope="col">{copy.type}</th>
                  <th scope="col">{copy.defaultValue}</th>
                </tr>
              </thead>
              <tbody>
                {abiEntry.properties.map((property) => (
                  <tr>
                    <th scope="row">
                      <code>{property.name}</code>
                    </th>
                    <td>
                      <code>{property.type}</code>
                    </td>
                    <td>
                      {property.defaultValue === undefined
                        ? copy.empty
                        : String(property.defaultValue)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
        <section aria-labelledby={`${id}-attributes`} class="contract-details">
          <h2 id={`${id}-attributes`}>{copy.attributes}</h2>
          <p>
            <code>
              {abiEntry.attributes.length
                ? abiEntry.attributes.join(", ")
                : copy.empty}
            </code>
          </p>
        </section>
        <section
          aria-labelledby={`${id}-events-methods`}
          class="contract-details"
        >
          <h2 id={`${id}-events-methods`}>{copy.eventsMethods}</h2>
          <p>
            Events:{" "}
            <code>
              {abiEntry.events.length ? abiEntry.events.join(", ") : copy.empty}
            </code>
          </p>
          <p>
            Methods:{" "}
            <code>
              {abiEntry.methods.length
                ? abiEntry.methods.join(", ")
                : copy.empty}
            </code>
          </p>
        </section>
      </>
    )
  }
</article>

<script>
  import { defineIkaSue } from "../../../src/elements";
  import { componentSourceForProps } from "../../../src/catalog/demo";
  import {
    isIkaJsonValue,
    isIkaViewProps,
    type IkaJsonRecord,
    type IkaJsonValue,
  } from "../../../src/contract";
  import type { CatalogComponentId } from "../../../src/catalog/types";

  defineIkaSue();

  type DemoConfig = {
    readonly props: IkaJsonRecord;
    readonly controls: readonly {
      readonly key: string;
      readonly label: { readonly ja: string; readonly en: string };
      readonly kind: "text" | "boolean" | "number" | "select" | "json";
      readonly options?: readonly string[];
      readonly min?: number;
      readonly max?: number;
    }[];
  };
  type DemoElement = HTMLElement & { props: IkaJsonRecord };

  const addTextChild = (
    parent: HTMLElement,
    content: string,
    tone = "default",
  ): void => {
    const child = parent.ownerDocument.createElement("ika-text") as DemoElement;
    child.props = { content, tone, selectable: true };
    parent.append(child);
  };

  const addDemoChildren = (
    id: CatalogComponentId,
    element: HTMLElement,
  ): void => {
    if (
      id === "theme-root" ||
      id === "flex" ||
      id === "stack" ||
      id === "grid"
    ) {
      addTextChild(element, "Primary work", "success");
      addTextChild(element, "Secondary detail", "muted");
      addTextChild(element, "Ready state", "default");
    }
  };

  document
    .querySelectorAll<HTMLElement>("[data-ika-demo-root]")
    .forEach((root) => {
      const id = root.dataset.ikaComponent as CatalogComponentId | undefined;
      const locale = root.dataset.ikaLocale === "en" ? "en" : "ja";
      const configNode = root.querySelector<HTMLScriptElement>(
        "[data-ika-demo-config]",
      );
      const preview = root.querySelector<HTMLElement>("[data-ika-preview]");
      const controls = root.querySelector<HTMLElement>(
        "[data-ika-control-list]",
      );
      const code = root.querySelector<HTMLElement>("[data-ika-code]");
      const status = root.querySelector<HTMLElement>("[data-ika-demo-status]");
      if (!id || !configNode || !preview || !controls || !code || !status)
        return;

      let config: DemoConfig;
      try {
        config = JSON.parse(configNode.textContent ?? "") as DemoConfig;
      } catch {
        status.textContent = "Unable to load demo configuration.";
        return;
      }
      let state: IkaJsonRecord = { ...config.props };
      let provider: "typescript" | "rust" = "typescript";
      const controlNodes = new Map<
        string,
        HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
      >();

      const displayValue = (value: unknown): string =>
        typeof value === "string"
          ? value
          : (JSON.stringify(value, null, 2) ?? "");

      const updateControlValues = (): void => {
        for (const control of config.controls) {
          const node = controlNodes.get(control.key);
          if (!node) continue;
          if (control.kind === "boolean" && node instanceof HTMLInputElement)
            node.checked = state[control.key] === true;
          else if (
            control.kind === "json" ||
            control.kind === "text" ||
            control.kind === "number"
          )
            node.value = displayValue(state[control.key]);
          else node.value = String(state[control.key] ?? "");
        }
      };

      const renderCode = (): void => {
        code.textContent = componentSourceForProps(id, state, provider);
        code.parentElement?.setAttribute("data-language", provider);
      };

      const renderPreview = (): boolean => {
        preview.replaceChildren();
        const invalidMessage =
          "This option combination is not valid for the public contract.";
        if (!isIkaViewProps(id, state)) {
          const error = preview.ownerDocument.createElement("p");
          error.textContent = invalidMessage;
          preview.append(error);
          return false;
        }
        const element = preview.ownerDocument.createElement(
          `ika-${id}`,
        ) as DemoElement;
        let rejected = false;
        element.addEventListener("ika-error", () => {
          rejected = true;
        });
        try {
          element.props = state;
        } catch {
          const error = preview.ownerDocument.createElement("p");
          error.textContent = invalidMessage;
          preview.append(error);
          return false;
        }
        if (rejected) {
          const error = preview.ownerDocument.createElement("p");
          error.textContent = invalidMessage;
          preview.append(error);
          return false;
        }
        addDemoChildren(id, element);
        preview.append(element);
        element.addEventListener("ika-active-change", (event) => {
          const next = (event as CustomEvent<{ readonly id?: unknown }>).detail
            ?.id;
          if (typeof next !== "string" || state.activeId === next) return;
          state = { ...state, activeId: next };
          updateControlValues();
          renderCode();
          status.textContent = `Active tab: ${next}`;
        });
        element.addEventListener("ika-dismiss", () => {
          element.remove();
          status.textContent =
            "Alert dismissed. Turn Dismissible off and on to restore it.";
        });
        return true;
      };

      const setState = (key: string, value: IkaJsonValue): void => {
        state = { ...state, [key]: value };
        const previewAccepted = renderPreview();
        renderCode();
        status.textContent = previewAccepted
          ? "Updated preview and provider code."
          : "The preview rejected these options; check the public contract.";
      };

      config.controls.forEach((control) => {
        const label = root.ownerDocument.createElement("label");
        label.className = "demo-control";
        const text = root.ownerDocument.createElement("span");
        text.textContent = control.label[locale];
        label.append(text);
        let node: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
        if (control.kind === "boolean") {
          const input = root.ownerDocument.createElement("input");
          input.type = "checkbox";
          node = input;
          label.classList.add("demo-control-boolean");
        } else if (control.kind === "select") {
          const select = root.ownerDocument.createElement("select");
          for (const option of control.options ?? []) {
            const item = root.ownerDocument.createElement("option");
            item.value = option;
            item.textContent = option;
            select.append(item);
          }
          node = select;
        } else if (control.kind === "json") {
          const textarea = root.ownerDocument.createElement("textarea");
          textarea.rows = 3;
          textarea.spellcheck = false;
          node = textarea;
        } else {
          const input = root.ownerDocument.createElement("input");
          input.type = control.kind === "number" ? "number" : "text";
          if (control.min !== undefined) input.min = String(control.min);
          if (control.max !== undefined) input.max = String(control.max);
          node = input;
        }
        node.name = control.key;
        node.setAttribute("aria-label", control.label[locale]);
        controlNodes.set(control.key, node);
        const eventName =
          control.kind === "select" || control.kind === "boolean"
            ? "change"
            : "input";
        node.addEventListener(eventName, () => {
          if (control.kind === "boolean" && node instanceof HTMLInputElement) {
            setState(control.key, node.checked);
            return;
          }
          if (control.kind === "json") {
            try {
              const value: unknown = JSON.parse(node.value);
              if (isIkaJsonValue(value)) setState(control.key, value);
            } catch {
              status.textContent =
                "JSON options must be valid before they are applied.";
            }
            return;
          }
          if (control.kind === "number") {
            const value = Number(node.value);
            if (Number.isFinite(value)) setState(control.key, value);
            return;
          }
          setState(control.key, node.value);
        });
        label.append(node);
        controls.append(label);
      });
      updateControlValues();

      const setupTabGroup = (list: HTMLElement): void => {
        const buttons = Array.from(
          list.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
        );
        const panelFor = (
          button: HTMLButtonElement,
        ): HTMLElement | undefined => {
          const panelId = button.getAttribute("aria-controls");
          return panelId
            ? Array.from(
                root.querySelectorAll<HTMLElement>('[role="tabpanel"]'),
              ).find((panel) => panel.id === panelId)
            : undefined;
        };
        const activate = (
          button: HTMLButtonElement,
          shouldFocus = false,
        ): void => {
          const panelIds = new Set(
            buttons
              .map((candidate) => candidate.getAttribute("aria-controls"))
              .filter((value): value is string => value !== null),
          );
          buttons.forEach((candidate) => {
            const selected = candidate === button;
            candidate.setAttribute("aria-selected", String(selected));
            candidate.tabIndex = selected ? 0 : -1;
          });
          root
            .querySelectorAll<HTMLElement>('[role="tabpanel"]')
            .forEach((panel) => {
              if (!panelIds.has(panel.id)) return;
              panel.hidden = true;
            });
          const panel = panelFor(button);
          if (panel) {
            panel.hidden = false;
            panel.setAttribute("aria-labelledby", button.id);
          }
          if (shouldFocus) button.focus();
        };
        buttons.forEach((button) =>
          button.addEventListener("click", () => {
            activate(button);
            if (list.dataset.ikaTabGroup === "provider") {
              const next = button.dataset.ikaProvider;
              if (next === "typescript" || next === "rust") {
                provider = next;
                renderCode();
              }
            }
          }),
        );
        list.addEventListener("keydown", (event) => {
          if (!(event.target instanceof HTMLButtonElement)) return;
          const current = buttons.indexOf(event.target);
          if (current < 0) return;
          const key = event.key;
          const delta =
            key === "ArrowLeft" || key === "ArrowUp"
              ? -1
              : key === "ArrowRight" || key === "ArrowDown"
                ? 1
                : 0;
          if (key !== "Home" && key !== "End" && delta === 0) return;
          event.preventDefault();
          const nextIndex =
            key === "Home"
              ? 0
              : key === "End"
                ? buttons.length - 1
                : (current + delta + buttons.length) % buttons.length;
          const next = buttons[nextIndex];
          if (next) {
            activate(next, true);
            if (list.dataset.ikaTabGroup === "provider") {
              const nextProvider = next.dataset.ikaProvider;
              if (nextProvider === "typescript" || nextProvider === "rust") {
                provider = nextProvider;
                renderCode();
              }
            }
          }
        });
        const selected = buttons.find(
          (button) => button.getAttribute("aria-selected") === "true",
        );
        if (selected) activate(selected);
      };
      root
        .querySelectorAll<HTMLElement>("[data-ika-tab-group]")
        .forEach(setupTabGroup);
      renderPreview();
      renderCode();
    });
</script>

