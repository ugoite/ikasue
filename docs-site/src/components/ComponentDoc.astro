---
import { Code } from "@astrojs/starlight/components";
import {
  componentMeta,
  componentPhilosophy,
  findComponent,
} from "../../../src/catalog/metadata";
import type { CatalogComponentId } from "../../../src/catalog/types";
import { COMPONENT_GUIDANCE } from "../data/component-guidance";
import { catalogPath } from "../data/site-path";

interface Props {
  id: CatalogComponentId;
}

const { id } = Astro.props;
const metadata = findComponent(id);
const guidance = COMPONENT_GUIDANCE[id];
const [goodFor, avoidFor, interaction] = componentMeta(id);
const contract = JSON.stringify(
  {
    component: metadata.name,
    id: metadata.id,
    props: Object.fromEntries(
      metadata.props.map((property) => [property.key, property.default]),
    ),
    events:
      id === "text"
        ? ["ikasue:commit"]
        : id === "focus-region"
          ? ["ikasue:layout-request"]
          : [],
    contract: [
      "new information enters from its semantic edge",
      "content is reallocated on one plane; no overlay is required",
      "keyboard and reduced-motion behavior remain available",
    ],
  },
  null,
  2,
);
---

<div class="component-doc">
  <p class="eyebrow">{metadata.ja} · {metadata.cat}</p>
  <p class="lede">{metadata.summary}</p>

  <div class="doc-links">
    <a href={catalogPath(metadata.id)} target="_blank" rel="noreferrer">
      Open interactive catalog ↗
    </a>
    <span>Demo id: <code>{metadata.demo}</code></span>
  </div>

  <h2>Contract / 契約</h2>
  <p>{componentPhilosophy(id)}</p>
  <Code code={contract} lang="json" title={`${metadata.name} contract`} />

  <div class="guidance-grid">
    <section>
      <h2>Use it when / 使う場面</h2>
      <p>{guidance.useWhen}</p>
    </section>
    <section>
      <h2>Avoid it when / 避ける場面</h2>
      <p>{guidance.avoidWhen}</p>
    </section>
  </div>

  <h2>Implementation / 実装の入口</h2>
  <p>{guidance.implementation}</p>
  <Code code={`import { mountCatalog } from "@ugoite/ikasue";\n\nconst target = document.querySelector("#workspace");\nif (target) {\n  mountCatalog(target, { component: "${metadata.id}" });\n}`} lang="ts" title="integration sketch" />

  <h2>Properties / props</h2>
  <div class="property-table">
    <table>
      <caption>{metadata.name} properties / props一覧</caption>
      <thead>
        <tr><th scope="col">Key</th><th scope="col">Type</th><th scope="col">Default</th><th scope="col">Values</th></tr>
      </thead>
      <tbody>
        {
          metadata.props.length ? metadata.props.map((property) => (
            <tr>
              <th scope="row"><code>{property.key}</code><small>{property.label}</small></th>
              <td><code>{property.type}</code></td>
              <td><code>{String(property.default)}</code></td>
              <td>{property.values.length ? property.values.join(" · ") : "—"}</td>
            </tr>
          )) : (
            <tr><td colspan="4">This conceptual runtime entry has no configurable props. / 設定propsなし。</td></tr>
          )
        }
      </tbody>
    </table>
  </div>

  <h2>Behavior & accessibility / 振る舞いとアクセシビリティ</h2>
  <dl class="behavior-list">
    <div><dt>Good for / 適する対象</dt><dd>{goodFor}</dd></div>
    <div><dt>Not for / 適さない対象</dt><dd>{avoidFor}</dd></div>
    <div><dt>Interaction / 操作</dt><dd>{interaction}</dd></div>
    <div><dt>Keyboard / キーボード</dt><dd>{guidance.keyboard}</dd></div>
    <div><dt>Accessibility / a11y</dt><dd>{guidance.accessibility}</dd></div>
  </dl>
</div>

<style>
  .component-doc {
    --plane-border: color-mix(in srgb, var(--sl-color-white) 18%, transparent);
  }

  .eyebrow {
    color: var(--sl-color-text-accent);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    letter-spacing: 0.04em;
  }

  .lede {
    max-width: 52rem;
    font-size: var(--sl-text-lg);
  }

  .doc-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
    margin-block: 1rem 2rem;
    padding-block: 0.75rem;
    border-block: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-sm);
  }

  .guidance-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .guidance-grid section {
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-inline-start: 3px solid var(--sl-color-text-accent);
  }

  .guidance-grid h2 {
    margin-block-start: 0;
    font-size: var(--sl-text-h4);
  }

  .property-table {
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 38rem;
    border-collapse: collapse;
  }

  th,
  td {
    border-block-end: 1px solid var(--sl-color-gray-5);
    padding: 0.65rem;
    text-align: start;
    vertical-align: top;
  }

  thead th {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-2);
  }

  small {
    display: block;
    color: var(--sl-color-gray-3);
    font-weight: 400;
  }

  .behavior-list {
    margin-block: 1rem 0;
  }

  .behavior-list > div {
    display: grid;
    grid-template-columns: minmax(9rem, 0.4fr) 1fr;
    gap: 1rem;
    padding-block: 0.7rem;
    border-block-end: 1px solid var(--sl-color-gray-5);
  }

  dt {
    color: var(--sl-color-text-accent);
    font-weight: 650;
  }

  dd {
    margin: 0;
  }

  @media (max-width: 48rem) {
    .guidance-grid {
      grid-template-columns: 1fr;
    }

    .behavior-list > div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
