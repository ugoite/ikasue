---
import { findRegistryEntry } from "../../../src/catalog/registry";
import type { CatalogComponentId, CatalogLocale } from "../../../src/catalog/types";

interface Props { id: CatalogComponentId; locale?: CatalogLocale }
const { id, locale = "ja" } = Astro.props as Props;
const entry = findRegistryEntry(id);
const summary = entry?.summary[locale] ?? "";
const componentEntry = entry?.kind === "component" ? entry : undefined;
const copy =
  locale === "ja"
    ? {
        contract: "契約",
        contractText:
          "用途に合う標準Webプリミティブを使います。レイアウトはCSS、インタラクションは明示的なstateが担います。",
        properties: "プロパティ",
        source: "使用例",
        name: "名前",
        type: "型",
        defaultValue: "既定値",
        empty: "—",
      }
    : {
        contract: "Contract",
        contractText:
          "Use the standard web primitive that matches this component. CSS owns layout and explicit state owns interaction.",
        properties: "Properties",
        source: "Usage",
        name: "Name",
        type: "Type",
        defaultValue: "Default",
        empty: "—",
      };
---

<article class="docs-component" data-kind={id}>
  <p class="eyebrow">{entry?.group ?? "component"}</p>
  <p>{summary}</p>
  <section aria-labelledby={`${id}-contract`}>
    <h2 id={`${id}-contract`}>{copy.contract}</h2>
    <p>{copy.contractText}</p>
  </section>
  {componentEntry && (
    <>
      <section aria-labelledby={`${id}-properties`}>
        <h2 id={`${id}-properties`}>{copy.properties}</h2>
        <table>
          <thead>
            <tr>
              <th scope="col">{copy.name}</th>
              <th scope="col">{copy.type}</th>
              <th scope="col">{copy.defaultValue}</th>
            </tr>
          </thead>
          <tbody>
            {componentEntry.properties.map((property) => (
              <tr>
                <th scope="row"><code>{property.name}</code></th>
                <td><code>{property.type}</code></td>
                <td>{property.default === undefined ? copy.empty : String(property.default)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
      <section aria-labelledby={`${id}-source`}>
        <h2 id={`${id}-source`}>{copy.source}</h2>
        <pre><code>{componentEntry.source.typescript}</code></pre>
      </section>
    </>
  )}
</article>
