---
import { Code, TabItem, Tabs } from "@astrojs/starlight/components";
import { findComponent } from "../../../src/catalog/metadata";
import type { CatalogComponentId } from "../../../src/catalog/types";
import {
  COMPONENT_UI_COPY,
  componentCopy,
} from "../data/component-copy";
import { componentSource } from "../data/component-source";
import { catalogPath, sitePath } from "../data/site-path";

interface Props {
  id: CatalogComponentId;
}

const { id } = Astro.props;
const locale = Astro.currentLocale === "en" ? "en" : "ja";
const metadata = findComponent(id);
const copy = componentCopy(locale, id);
const ui = COMPONENT_UI_COPY[locale];
const source = componentSource(id);
const localePrefix = locale === "en" ? "en/" : "";
const englishPropertyDefaults: Partial<Record<string, string>> = {
  ...(id === "text" ? { value: "Tokyo office" } : {}),
  ...(id === "boolean-text" ? { label: "Enable automatic save" } : {}),
  ...(id === "status-icon" ? { label: "Synced" } : {}),
};
const displayDefault = (key: string, value: unknown) =>
  locale === "en" ? (englishPropertyDefaults[key] ?? value) : value;
const contract = JSON.stringify(
  {
    component: metadata.name,
    id: metadata.id,
    props: Object.fromEntries(metadata.props.map((property) => [
      property.key,
      displayDefault(property.key, property.default),
    ])),
    plane: {
      axis: id === "horizontal" || id === "rule" || id === "choice-group" || id === "data-table" || id === "action-strip" || id === "icon-action" || id === "status-icon" ? "horizontal" : "vertical",
      fit: id === "horizontal" ? "wrap" : "elastic",
      children: ["primary", "secondary"],
    },
    ownership:
      id === "form-list"
        ? "FormList owns values and status; child focus and draft remain local and do not recolor source data."
        : "The component owns only the state named by its contract; its plane owner resolves shared space.",
    contract: [
      "new information enters from its semantic edge",
      "content is reallocated on one plane; no overlay is required",
      "keyboard and reduced-motion behavior remain available",
    ],
  },
  null,
  2,
);
---

<div class="component-doc">
  <p class="eyebrow">
    {locale === "ja" ? `${metadata.ja} · ${copy.category}` : copy.category}
  </p>
  <p class="lede">{copy.summary}</p>

  <div class="doc-links">
    <a href={catalogPath(metadata.id, locale)} target="_blank" rel="noreferrer">
      {ui.catalogLink}
    </a>
    <span>{ui.demoId} <code>{metadata.demo}</code></span>
    <a href={sitePath(`${localePrefix}components/`)}>{ui.matrixLink}</a>
  </div>

  <h2>{ui.contract}</h2>
  <p>{copy.philosophy}</p>
  <Code code={contract} lang="json" title={`${metadata.name} ${ui.contract}`} />

  <div class="guidance-grid">
    <section>
      <h2>{ui.useWhen}</h2>
      <p>{copy.useWhen}</p>
    </section>
    <section>
      <h2>{ui.avoidWhen}</h2>
      <p>{copy.avoidWhen}</p>
    </section>
  </div>

  <h2>{ui.implementation}</h2>
  <p>{copy.implementation}</p>
  <p class="source-note">{ui.implementationUsage}</p>
  <Tabs>
    <TabItem label={ui.javascript}>
      <Code code={source.javascript} lang="js" title={ui.javascript} />
    </TabItem>
    <TabItem label={ui.rust}>
      <Code code={source.rust} lang="rust" title={ui.rust} />
    </TabItem>
  </Tabs>

  <h2>{ui.properties}</h2>
  <div class="property-table">
    <table>
      <caption>{ui.propertiesCaption(metadata.name)}</caption>
      <thead>
        <tr><th scope="col">{ui.key}</th><th scope="col">{ui.type}</th><th scope="col">{ui.defaultValue}</th><th scope="col">{ui.values}</th></tr>
      </thead>
      <tbody>
        {
          metadata.props.length ? metadata.props.map((property) => (
            <tr>
              <th scope="row"><code>{property.key}</code><small>{copy.propertyLabels[property.key] ?? property.key}</small></th>
              <td><code>{property.type}</code></td>
              <td><code>{String(displayDefault(property.key, property.default))}</code></td>
              <td>{property.values.length ? property.values.join(" · ") : "—"}</td>
            </tr>
          )) : (
            <tr><td colspan="4">{ui.noProps}</td></tr>
          )
        }
      </tbody>
    </table>
  </div>

  <h2>{ui.behaviorAccessibility}</h2>
  <dl class="behavior-list">
    <div><dt>{ui.goodFor}</dt><dd>{copy.goodFor}</dd></div>
    <div><dt>{ui.avoidFor}</dt><dd>{copy.avoidFor}</dd></div>
    <div><dt>{ui.interaction}</dt><dd>{copy.interaction}</dd></div>
    <div><dt>{ui.keyboard}</dt><dd>{copy.keyboard}</dd></div>
    <div><dt>{ui.accessibility}</dt><dd>{copy.accessibility}</dd></div>
  </dl>
</div>

<style>
  .component-doc {
    --plane-border: color-mix(in srgb, var(--sl-color-white) 18%, transparent);
  }

  .eyebrow {
    color: var(--sl-color-text-accent);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    letter-spacing: 0.04em;
  }

  .lede {
    max-width: 52rem;
    font-size: var(--sl-text-lg);
  }

  .doc-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
    margin-block: 1rem 2rem;
    padding-block: 0.75rem;
    border-block: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-sm);
  }

  .guidance-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .guidance-grid section {
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-inline-start: 3px solid var(--sl-color-text-accent);
  }

  .source-note {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .guidance-grid h2 {
    margin-block-start: 0;
    font-size: var(--sl-text-h4);
  }

  .property-table {
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 38rem;
    border-collapse: collapse;
  }

  th,
  td {
    border-block-end: 1px solid var(--sl-color-gray-5);
    padding: 0.65rem;
    text-align: start;
    vertical-align: top;
  }

  thead th {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-2);
  }

  small {
    display: block;
    color: var(--sl-color-gray-3);
    font-weight: 400;
  }

  .behavior-list {
    margin-block: 1rem 0;
  }

  .behavior-list > div {
    display: grid;
    grid-template-columns: minmax(9rem, 0.4fr) 1fr;
    gap: 1rem;
    padding-block: 0.7rem;
    border-block-end: 1px solid var(--sl-color-gray-5);
  }

  dt {
    color: var(--sl-color-text-accent);
    font-weight: 650;
  }

  dd {
    margin: 0;
  }

  @media (max-width: 48rem) {
    .guidance-grid {
      grid-template-columns: 1fr;
    }

    .behavior-list > div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
